# ============================================================================
# Backend Configuration
# ============================================================================
# Required: Your Groq API key (get it from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Optional: LLM API timeout in seconds (default: 30)
LLM_TIMEOUT=30

# ============================================================================
# Frontend Configuration
# ============================================================================
# Optional: API endpoint for Streamlit frontend (default: http://localhost:8000)
# For production: Use your deployed backend URL
# Example: https://api.yourdomain.com
API_ENDPOINT=http://localhost:8000
